{
    // Copied by build.ps1 to build\vscode\data\user-data\User\settings.json
    "python.defaultInterpreterPath": "C:\\Program Files\\Algoritmika\\python\\python.exe",
    "python.terminal.executeInFileDir": true,
    // Completions from Jedi (bundled in the Python extension), as in 4.7: case-insensitive ("from pyq" -> PyQt5).
    // Pylance refuses to start unless the app is named "Visual Studio Code"; Pyright-based servers match
    // module names case-sensitively, so "from pyqt5" suggests nothing.
    "python.languageServer": "Jedi",
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "terminal.integrated.env.windows": {
        // PyQt5 >= 5.15.4 keeps its plugins in Qt5\, not Qt\ (4.7 pointed at a folder that doesn't exist).
        // Set explicitly so a global QT_* variable left by other Qt software can't hand PyQt5 a foreign qwindows.dll.
        "QT_PLUGIN_PATH": "C:\\Program Files\\Algoritmika\\python\\Lib\\site-packages\\PyQt5\\Qt5\\plugins",
        "QT_QPA_PLATFORM_PLUGIN_PATH": "C:\\Program Files\\Algoritmika\\python\\Lib\\site-packages\\PyQt5\\Qt5\\plugins\\platforms"
    },
    "extensions.ignoreRecommendations": true,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": false,
    "update.mode": "none",
    "security.workspace.trust.enabled": false,
    // students' own work: no Copilot chat, completions or the right-hand chat panel
    "chat.disableAIFeatures": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.startupEditor": "none",
    "workbench.editor.enablePreview": false
}
