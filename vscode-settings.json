{
    // Copied by build.ps1 to build\vscode\data\user-data\User\settings.json
    "python.defaultInterpreterPath": "C:\\Program Files\\Algoritmika\\python\\python.exe",
    "python.terminal.executeInFileDir": true,
    // Completions come from basedpyright: Pylance refuses to start unless the app is named "Visual Studio Code".
    // Its defaults are made to match Pylance's: no type-checking errors, no inline type hints.
    "python.languageServer": "None",
    "basedpyright.analysis.typeCheckingMode": "off",
    "basedpyright.analysis.inlayHints.variableTypes": false,
    "basedpyright.analysis.inlayHints.callArgumentNames": false,
    "basedpyright.analysis.inlayHints.functionReturnTypes": false,
    "basedpyright.analysis.inlayHints.genericTypes": false,
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "terminal.integrated.env.windows": {
        // PyQt5 >= 5.15.4 keeps its plugins in Qt5\, not Qt\ (4.7 pointed at a folder that doesn't exist).
        // Set explicitly so a global QT_* variable left by other Qt software can't hand PyQt5 a foreign qwindows.dll.
        "QT_PLUGIN_PATH": "C:\\Program Files\\Algoritmika\\python\\Lib\\site-packages\\PyQt5\\Qt5\\plugins",
        "QT_QPA_PLATFORM_PLUGIN_PATH": "C:\\Program Files\\Algoritmika\\python\\Lib\\site-packages\\PyQt5\\Qt5\\plugins\\platforms"
    },
    "extensions.ignoreRecommendations": true,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": false,
    "update.mode": "none",
    "security.workspace.trust.enabled": false,
    // students' own work: no Copilot chat, completions or the right-hand chat panel
    "chat.disableAIFeatures": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.startupEditor": "none",
    "workbench.editor.enablePreview": false
}
